# Usado pelo docker-compose.yml (raiz do projeto). Para correr backend/frontend
# localmente com pnpm, usa antes apps/backend/.env e apps/frontend/.env.
POSTGRES_USER=opencrm
POSTGRES_PASSWORD=changeme
POSTGRES_DB=opencrm

BACKEND_PORT=3000
JWT_SECRET=changeme_jwt_secret
JWT_REFRESH_SECRET=changeme_jwt_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# URL do webhook do n8n para automações (Fase 5). Deixa vazio para desativar.
N8N_WEBHOOK_URL=

FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000

INTERNAL_API_KEY=changeme_internal_api_key

EMAIL_ADDRESS=
EMAIL_PASSWORD=
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true

MINIO_ACCESS_KEY=opencrm
MINIO_SECRET_KEY=changeme_minio_secret
MINIO_BUCKET=email-attachments

# Origens extra autorizadas a chamar a API (separadas por vírgulas). Opcional: por omissão já são
# aceites localhost e IPs/nomes da rede local (192.168.x.x, 10.x.x.x, 172.16-31.x.x, *.local).
CORS_ORIGINS=

# Com NODE_ENV=production o backend recusa arrancar se JWT_SECRET, JWT_REFRESH_SECRET ou
# INTERNAL_API_KEY ainda tiverem o valor de exemplo "changeme_*".
# NODE_ENV=production

# --- Arranque completo em Docker (docker compose up -d --build) ---------------------------------
# Endereço do servidor visto a partir dos browsers da rede (NÃO use localhost se outros computadores acedem):
# VITE_API_URL=http://192.168.50.10:3000      (acima; é embutido no frontend na compilação — mudar exige --build)
# MINIO_PUBLIC_URL=http://192.168.50.10:9000  (links de download de anexos)
# FRONTEND_URL=http://192.168.50.10:5173      (links do email de recuperação de password)
MINIO_PUBLIC_URL=
FRONTEND_URL=http://localhost:5173
# Portas no anfitrião (mudar só se houver conflito):
# POSTGRES_HOST_PORT=5432
# MINIO_HOST_PORT=9000
# MINIO_CONSOLE_HOST_PORT=9001

# --- Cópias de segurança (serviço "backup" do compose) ---------------------------------------------
# Pasta no servidor onde ficam as cópias. Aponta a um OUTRO disco ou partilha de rede: uma cópia no mesmo
# disco não protege de uma avaria do disco. Contém dados pessoais e hashes de passwords: protege a pasta.
# BACKUP_DIR=./backups
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP_DAYS=14
