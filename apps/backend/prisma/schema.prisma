generator client {
  provider        = "prisma-client-js"
  // omitApi: esconder colunas internas (searchText) de todas as respostas — ver src/prisma/prisma.service.ts.
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMINISTRADOR
  COMERCIAL
  TECNICO
  BACKOFFICE
  FINANCEIRO
  LEITURA_APENAS
}

model User {
  id                    String                @id @default(uuid())
  email                 String                @unique
  name                  String
  passwordHash          String
  role                  Role                  @default(COMERCIAL)
  // Desativar em vez de eliminar: o utilizador está ligado a negócios, tarefas, leads e à timeline.
  active                Boolean               @default(true)
  refreshToken          String?
  // SHA-256 do token enviado por email (nunca o token). Ver docs/plano-e0-api-publica.md.
  resetTokenHash        String?               @unique
  resetTokenExpiresAt   DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  timelineEvents        TimelineEvent[]
  deals                 Deal[]
  workItems             WorkItem[]
  leads                 Lead[]
  ownedCompanies        Company[]
  ownedContacts         Contact[]
  auditEvents           AuditEvent[]
  apiKeys               ApiKey[]
  webhookSubscriptions  WebhookSubscription[]
  timeEntries           TimeEntry[]           @relation("TimeEntryUser")
  editedTimeEntries     TimeEntry[]           @relation("TimeEntryEditor")
  ServicePart           ServicePart[]
  StockMovement         StockMovement[]
  salesOrdersAssigned   SalesOrder[]          @relation("SalesOrderAssignee")
  salesOrdersCreated    SalesOrder[]          @relation("SalesOrderCreatedBy")
  purchaseOrdersCreated PurchaseOrder[]       @relation("PurchaseOrderCreatedBy")
  shipmentsCreated      Shipment[]            @relation("ShipmentCreatedBy")
}

enum TimelineEventType {
  NOTE
  CALL
  EMAIL
  MEETING
  FILE
  SYSTEM
}

enum TimelineEntityType {
  COMPANY
  CONTACT
  LEAD
  DEAL
  TASK
  /// Encomendas de cliente (Fase 6a).
  ORDER
  /// Compras a fornecedor (Fase 6c).
  PURCHASE_ORDER
}

model TimelineEvent {
  id          String             @id @default(uuid())
  entityType  TimelineEntityType
  entityId    String
  userId      String
  user        User               @relation(fields: [userId], references: [id])
  type        TimelineEventType  @default(NOTE)
  title       String?
  description String?
  metadata    Json?
  createdAt   DateTime           @default(now())

  @@index([entityType, entityId, createdAt(sort: Desc), id(sort: Desc)])
}

enum CompanyStatus {
  ATIVO
  POTENCIAL
  INATIVO
  PERDIDO
}

enum CompanySource {
  SITE
  LOJA
  CHAMADA
  CAMPANHA
  IMPORTACAO
  RECOMENDACAO
  OUTRO
}

enum PreferredChannel {
  TELEFONE
  EMAIL
  WHATSAPP
  PRESENCIAL
}

model Company {
  id               String            @id @default(uuid())
  name             String
  legalName        String?
  taxId            String?
  website          String?
  phone            String?
  email            String?
  address          String?
  postalCode       String?
  city             String?
  country          String?
  status           CompanyStatus     @default(POTENCIAL)
  source           CompanySource?
  ownerId          String?
  owner            User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  notes            String?
  /// Nome, nome fiscal, NIF, telefone e email, em minúsculas e sem acentos (unaccent), para a pesquisa com pg_trgm (mantido por um trigger; não sai na API).
  /// Também fornecedor (Fase 5a): aparece nos fornecedores dos produtos.
  isSupplier       Boolean           @default(false)
  suppliedProducts ProductSupplier[]
  searchText       String            @default("")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  contacts         Contact[]
  deals            Deal[]
  workItems        WorkItem[]
  emails           EmailMessage[]
  callRecords      CallRecord[]
  leads            Lead[]

  salesOrders    SalesOrder[]
  /// Compras a este fornecedor (Fase 6c).
  purchaseOrders PurchaseOrder[]

  @@index([ownerId])
  @@index([name, id])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Contact {
  id               String            @id @default(uuid())
  name             String
  email            String?
  phone            String?
  mobilePhone      String?
  jobTitle         String?
  department       String?
  preferredChannel PreferredChannel?
  isDecisionMaker  Boolean           @default(false)
  marketingConsent Boolean           @default(false)
  notes            String?
  /// Nome, email, telefone e telemóvel, em minúsculas e sem acentos (unaccent), para a pesquisa com pg_trgm (mantido por um trigger; não sai na API).
  searchText       String            @default("")
  companyId        String?
  company          Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  ownerId          String?
  owner            User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deals            Deal[]
  workItems        WorkItem[]
  emails           EmailMessage[]
  callRecords      CallRecord[]
  leads            Lead[]

  salesOrders SalesOrder[]

  @@index([companyId])
  @@index([ownerId])
  @@index([name, id])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// Categoria fixa de um passo: o que a agenda e os relatórios usam sem conhecer o nome dado pelo utilizador.
enum WorkflowStepCategory {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

/// Resultado de um passo concluído (só com categoria DONE). Nos negócios: ganho ou perdido.
enum WorkflowOutcome {
  WON
  LOST
}

// Fluxo genérico (Fase 0c, docs/plano-fase-0-fundacoes.md): era o «funil» (Pipeline) dos negócios; os ids não mudaram.
model Workflow {
  id              String           @id @default(uuid())
  /// Tipo de coisa que passa por este fluxo ("DEAL"; os módulos futuros juntam os seus em src/workflows/workflow-registry.ts).
  entityType      String
  name            String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  steps           WorkflowStep[]
  deals           Deal[]
  automationRules AutomationRule[]
  workItemType    WorkItemType?

  @@index([entityType])
}

// Passo de um fluxo (era a «fase», Stage). Regras de categoria/resultado: src/workflows/workflow-steps.ts.
model WorkflowStep {
  id              String               @id @default(uuid())
  name            String
  order           Int
  category        WorkflowStepCategory @default(OPEN)
  /// Só em passos DONE (há uma restrição CHECK na base de dados).
  outcome         WorkflowOutcome?
  workflowId      String
  workflow        Workflow             @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  deals           Deal[]
  workItems       WorkItem[]
  automationRules AutomationRule[]

  @@index([workflowId])
}

model Deal {
  id              String        @id @default(uuid())
  title           String
  value           Float         @default(0)
  probability     Int           @default(0)
  order           Int           @default(0)
  type            BusinessArea?
  estimatedMargin Float?
  lossReason      String?
  pipelineId      String
  pipeline        Workflow      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stageId         String
  stage           WorkflowStep  @relation(fields: [stageId], references: [id], onDelete: Restrict)
  stageEnteredAt  DateTime      @default(now())
  contactId       String?
  contact         Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId       String?
  company         Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  ownerId         String
  owner           User          @relation(fields: [ownerId], references: [id])
  closedAt        DateTime?
  /// Coluna interna de pesquisa (título sem acentos), mantida por trigger.
  searchText      String        @default("")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  workItems       WorkItem[]
  lead            Lead?

  @@index([pipelineId])
  @@index([stageId])
  @@index([stageId, order, id])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

// Regra de automação (Fase 3a, docs/plano-fase-3-automacoes.md): «quando <gatilho> num <tipo de registo> e as
// condições se verificam → <ação>». Gatilhos, ações e campos vêm de registos em src/automations/registry/ (texto
// validado, não enums: um módulo novo junta os seus sem migração).
model AutomationRule {
  id            String          @id @default(uuid())
  name          String
  active        Boolean         @default(true)
  /// Regras do sistema (ex.: "lead.first_contact"): o arranque cria as que faltem; desativam-se mas não se apagam.
  systemKey     String?         @unique
  /// Tipo de registo: DEAL, WORK_ITEM, LEAD (src/automations/registry/automation-entities.ts).
  entityType    String          @default("DEAL")
  /// Âmbito opcional: só registos deste fluxo / neste passo (alguns gatilhos exigem o passo).
  workflowId    String?
  workflow      Workflow?       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepId        String?
  step          WorkflowStep?   @relation(fields: [stepId], references: [id], onDelete: Cascade)
  trigger       String
  triggerConfig Json            @default("{}")
  /// Lista de { field, operator, value }: todas têm de se verificar.
  conditions    Json            @default("[]")
  action        String
  actionConfig  Json            @default("{}")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  runs          AutomationRun[]

  @@index([workflowId])
  @@index([stepId])
  @@index([entityType, trigger, active])
}

enum AutomationRunOutcome {
  SUCCEEDED
  SKIPPED
  FAILED
}

/// Histórico de execuções (só de acrescentar; limpeza ao fim de 90 dias): o que correu, o que foi ignorado e porquê.
model AutomationRun {
  id         String               @id @default(uuid())
  ruleId     String
  rule       AutomationRule       @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  trigger    String
  outcome    AutomationRunOutcome
  /// Motivo (ignorada) ou erro (falhou), em texto para o administrador.
  message    String?
  /// Profundidade na cadeia (0 = causada por uma pessoa ou pelo agendamento; 1+ = por outra automação).
  depth      Int                  @default(0)
  createdAt  DateTime             @default(now())

  @@index([createdAt, id])
  @@index([ruleId, createdAt])
  @@index([entityType, entityId])
}

enum WorkItemStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum WorkItemPriority {
  BAIXA
  NORMAL
  ALTA
  URGENTE
}

// Tipo de item de trabalho (Fase 2a, docs/plano-fase-2-itens-de-trabalho.md): «Tarefa», «Visita», «Assistência»...
// Configurável pelo Administrador. O id é o código estável (não muda depois de criado). Os tipos de sistema estão
// também em código (src/work-item-types/system-types.ts) e o arranque repõe os que faltem.
model WorkItemType {
  id         String     @id
  name       String
  /// Nome de um ícone da lista fechada do frontend (nunca SVG vindo da base de dados).
  icon       String
  /// Nome de uma cor da paleta fechada.
  color      String
  isSystem   Boolean    @default(false)
  active     Boolean    @default(true)
  sortOrder  Int        @default(0)
  /// Tem item próprio no menu principal, com a página do tipo (Fase 2c).
  showInMenu Boolean    @default(false)
  /// Fluxo de passos do tipo (Fase 2b), `entityType` WORK_ITEM. Sem fluxo, os itens só têm estado.
  workflowId String?    @unique
  workflow   Workflow?  @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      WorkItem[]
}

// Item de trabalho (era a «tarefa», Task): o que a agenda e as listas veem. A API continua em /tasks.
model WorkItem {
  id             String           @id @default(uuid())
  title          String
  description    String?
  status         WorkItemStatus   @default(PENDING)
  typeId         String           @default("TAREFA")
  type           WorkItemType     @relation(fields: [typeId], references: [id], onDelete: Restrict)
  /// Passo do fluxo do tipo (só em tipos com passos). O estado deriva da categoria do passo (trigger confirma).
  stepId         String?
  step           WorkflowStep?    @relation(fields: [stepId], references: [id], onDelete: Restrict)
  priority       WorkItemPriority @default(NORMAL)
  result         String?
  dueDate        DateTime?
  /// Horário marcado (Fase 2d), opcional e além do prazo. O fim exige início e não é antes dele (CHECK).
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  /// Coluna interna (trigger): início marcado, senão o prazo. É o momento na agenda.
  agendaAt       DateTime?
  /// Quando fechou (concluída ou cancelada); vazio se está em aberto. Mantido por trigger (Fase 4c).
  closedAt       DateTime?
  assigneeId     String
  assignee       User             @relation(fields: [assigneeId], references: [id])
  contactId      String?
  contact        Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId      String?
  company        Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  dealId         String?
  deal           Deal?            @relation(fields: [dealId], references: [id], onDelete: SetNull)
  leadId         String?
  lead           Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  /// Encomenda a que a tarefa diz respeito (Fase 6c: «Preparar encomenda»).
  salesOrderId   String?
  salesOrder     SalesOrder?      @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  reminders      Reminder[]
  /// Dados próprios quando o item é uma assistência (módulo assistencias, Fase 4a).
  serviceCase    ServiceCase?
  timeEntries    TimeEntry[]
  /// Coluna interna mantida por trigger (prazo, ou 9999-12-31 sem prazo).
  dueSort        DateTime         @default(dbgenerated("'9999-12-31 00:00:00'::timestamp without time zone"))
  /// Coluna interna de pesquisa (título e descrição sem acentos), mantida por trigger.
  searchText     String           @default("")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([assigneeId])
  @@index([dueDate])
  @@index([typeId])
  @@index([stepId])
  @@index([agendaAt])
  @@index([closedAt])
  @@index([salesOrderId])
  @@index([dueSort, createdAt(sort: Desc), id(sort: Desc)])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Reminder {
  id         String   @id @default(uuid())
  remindAt   DateTime
  message    String?
  workItemId String
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([workItemId])
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

model EmailAccount {
  id         String         @id @default(uuid())
  email      String         @unique
  imapHost   String
  imapPort   Int
  imapSecure Boolean        @default(true)
  smtpHost   String
  smtpPort   Int
  smtpSecure Boolean        @default(true)
  username   String
  password   String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  messages   EmailMessage[]
}

model EmailMessage {
  id          String         @id @default(uuid())
  accountId   String
  account     EmailAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  direction   EmailDirection
  messageId   String         @unique
  fromAddress String
  fromName    String?
  toAddresses String[]
  subject     String?
  textBody    String?
  htmlBody    String?
  contactId   String?
  contact     Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId   String?
  company     Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  attachments Attachment[]
  sentAt      DateTime
  /// Coluna interna de pesquisa (assunto, remetente, destinatários sem acentos), mantida por trigger.
  searchText  String         @default("")
  createdAt   DateTime       @default(now())

  @@index([accountId])
  @@index([contactId])
  @@index([companyId])
  @@index([sentAt(sort: Desc), id(sort: Desc)])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Attachment {
  id         String       @id @default(uuid())
  messageId  String
  message    EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename   String
  mimeType   String
  size       Int
  storageKey String
  createdAt  DateTime     @default(now())

  @@index([messageId])
}

model EmailTemplate {
  id        String   @id @default(uuid())
  name      String
  subject   String
  body      String
  category  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ZadarmaAccount {
  id              String    @id @default(uuid())
  apiKey          String
  apiSecret       String
  callerExtension String?
  active          Boolean   @default(true)
  lastSyncAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

model CallRecord {
  id           String        @id @default(uuid())
  externalId   String        @unique
  direction    CallDirection
  fromNumber   String
  toNumber     String
  duration     Int           @default(0)
  disposition  String?
  recordingUrl String?
  contactId    String?
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId    String?
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  startedAt    DateTime
  createdAt    DateTime      @default(now())

  @@index([contactId])
  @@index([companyId])
  @@index([startedAt(sort: Desc), id(sort: Desc)])
}

enum BusinessArea {
  IMPRESSAO
  SOFTWARE
  INFORMATICA
  PAPELARIA
  POS
  ASSISTENCIA
  OUTRO
}

enum LeadStatus {
  NOVO
  CONTACTADO
  SEM_RESPOSTA
  CONVERTIDO
  PERDIDO
}

/// Lead de uma EMPRESA ou de uma PESSOA (Fase 1, docs/plano-fase-1-leads.md).
enum LeadKind {
  COMPANY
  PERSON
}

model Lead {
  id              String        @id @default(uuid())
  kind            LeadKind      @default(PERSON)
  name            String
  companyName     String?
  /// NIF (leads de empresa), para detetar duplicados na conversão.
  taxId           String?
  /// Cargo (leads de pessoa).
  jobTitle        String?
  /// Ligação opcional a registos que já existem (a lead pode existir só com dados soltos e ligar-se depois).
  companyId       String?
  company         Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId       String?
  contact         Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  phone           String?
  email           String?
  source          String?
  interest        BusinessArea?
  status          LeadStatus    @default(NOVO)
  responsavelId   String?
  responsavel     User?         @relation(fields: [responsavelId], references: [id], onDelete: SetNull)
  nextActionAt    DateTime?
  /// = nextActionAt, ou 9999-12-31 sem data: chave de ordenação/cursor da listagem (mantida por um trigger).
  nextActionSort  DateTime      @default(dbgenerated("'9999-12-31 00:00:00'::timestamp without time zone"))
  /// Nome/empresa/NIF/email/telefone em minúsculas e sem acentos (unaccent), para a pesquisa com pg_trgm (mantido por um trigger).
  searchText      String        @default("")
  notes           String?
  convertedDealId String?       @unique
  convertedDeal   Deal?         @relation(fields: [convertedDealId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  workItems       WorkItem[]

  @@index([responsavelId])
  @@index([status])
  // Validados pelo teste de carga (Fase 1a): listagem por separador, página única, contagens, pesquisa.
  @@index([status, responsavelId, nextActionSort, id])
  @@index([status, nextActionSort, id])
  @@index([nextActionSort, id])
  @@index([kind, status])
  @@index([responsavelId, status])
  @@index([companyId])
  @@index([contactId])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

enum CustomFieldType {
  TEXT
  TEXTAREA
  NUMBER
  CURRENCY
  DATE
  BOOLEAN
  SELECT
  MULTISELECT
  EMAIL
  PHONE
  URL
}

model CustomField {
  id                  String             @id @default(uuid())
  /// Tipo de registo ("COMPANY", "LEAD"...). Texto, não enum: os tipos válidos estão em
  /// src/custom-fields/entity-registry.ts e cada módulo novo junta o seu (Fase 0b).
  entityType          String
  /// Âmbito dentro do tipo de registo ("" = todos). Em WORK_ITEM, o id de um tipo de tarefa (Fase 2b).
  scopeId             String             @default("")
  sectionName         String?
  fieldName           String
  fieldLabel          String
  fieldType           CustomFieldType
  options             Json?
  isRequired          Boolean            @default(false)
  isVisible           Boolean            @default(true)
  isSearchable        Boolean            @default(false)
  isFilterable        Boolean            @default(false)
  isAutomationEnabled Boolean            @default(false)
  sortOrder           Int                @default(0)
  permissions         Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  values              CustomFieldValue[]

  @@unique([entityType, scopeId, fieldName])
}

model CustomFieldValue {
  id            String      @id @default(uuid())
  customFieldId String
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  entityType    String
  entityId      String
  valueText     String?
  valueNumber   Float?
  valueDate     DateTime?
  valueBoolean  Boolean?
  valueJson     Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([customFieldId, entityId])
  @@index([entityType, entityId])
}

/// Preferências do menu principal (Fase 2c), definidas pelo Administrador: uma só linha (id "default") com a lista
/// ordenada de entradas (itens e cabeçalhos de grupo). Os itens em si vivem no código do frontend.
model MenuSetting {
  id        String   @id @default("default")
  entries   Json     @default("[]")
  updatedAt DateTime @updatedAt
}

/// Estado dos módulos opcionais. Sem linha para um módulo = valor por omissão do manifesto (ativo).
/// Os dados de um módulo desligado NUNCA se apagam: desligar só esconde e bloqueia.
model ModuleSetting {
  moduleId  String   @id
  enabled   Boolean
  options   Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// Registo de auditoria: quem fez o quê e quando. SÓ DE ACRESCENTAR (um trigger na migração recusa UPDATE e DELETE).
// Nunca guarda segredos nem corpos de pedidos completos: só campos escolhidos (ver src/audit/).
model AuditEvent {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  /// null = ação do sistema (p. ex. o comando secrets:encrypt)
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  /// Nome no momento da ação (o utilizador pode mudar de nome depois).
  actorName  String?
  /// Ex.: "user.updated", "module.disabled" (ver docs/plano-e0-api-publica.md).
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?

  @@index([createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
}

// Chaves de API para integrações (E0c, docs/plano-e0-api-publica.md). Só o SHA-256 da chave fica guardado.
model ApiKey {
  id                 String              @id @default(uuid())
  name               String
  /// Primeiros caracteres da chave, só para a reconhecer na lista.
  prefix             String
  keyHash            String              @unique
  scopes             String[]
  rateLimitPerMinute Int                 @default(120)
  /// Quem criou a chave: as tarefas criadas por esta chave (p. ex. «Contactar lead») são atribuídas a esta pessoa.
  createdById        String
  createdBy          User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime            @default(now())
  expiresAt          DateTime?
  lastUsedAt         DateTime?
  revokedAt          DateTime?
  idempotencyRecords IdempotencyRecord[]

  @@index([createdAt])
}

// Pedidos da API pública já executados, para repetições com o mesmo Idempotency-Key devolverem a mesma resposta.
model IdempotencyRecord {
  id           String    @id @default(uuid())
  apiKeyId     String
  apiKey       ApiKey    @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  key          String
  method       String
  path         String
  requestHash  String
  /// null = ainda em curso
  status       Int?
  responseBody Json?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  @@unique([apiKeyId, key])
  @@index([createdAt])
}

// Webhooks de saída (E0d, docs/plano-e0-api-publica.md): quem quer ser avisado de que eventos.
model WebhookSubscription {
  id                  String            @id @default(uuid())
  name                String
  url                 String
  /// Tipos de evento ("lead.created"...) ou "*" para todos.
  events              String[]
  /// Segredo de assinatura, CIFRADO em repouso (ver common/secret-fields.ts).
  secret              String
  active              Boolean           @default(true)
  /// Porque foi desativada automaticamente (disjuntor), se foi.
  disabledReason      String?
  consecutiveFailures Int               @default(0)
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  createdById         String
  createdBy           User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deliveries          WebhookDelivery[]
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

// Fila persistente de entregas: grava-se ANTES de tentar enviar; repete com recuo até esgotar as tentativas.
model WebhookDelivery {
  id             String                @id @default(uuid())
  subscriptionId String
  subscription   WebhookSubscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  /// Id do EVENTO (igual em todas as subscrições e repetições), para o consumidor deduplicar.
  eventId        String
  eventType      String
  /// O envelope completo que é enviado.
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime              @default(now())
  /// Reserva: enquanto estiver no futuro, outra tentativa não pega nesta entrega.
  lockedUntil    DateTime?
  lastStatusCode Int?
  lastError      String?
  createdAt      DateTime              @default(now())
  deliveredAt    DateTime?

  @@index([status, nextAttemptAt])
  @@index([subscriptionId, createdAt(sort: Desc)])
}

// Ligação entre um registo do CRM e o mesmo objeto num sistema externo (E0e, docs/plano-e0-api-publica.md).
// Polimórfica (entityType + entityId), por isso sem chave estrangeira: quem apaga o registo apaga a ligação.
model ExternalLink {
  id         String   @id @default(uuid())
  /// Quem criou a ligação: "api_key:<id>" para a API pública; os adaptadores futuros usam nomes próprios.
  provider   String
  /// "lead" (e outros, à medida que os conectores os usarem).
  entityType String
  entityId   String
  externalId String
  createdAt  DateTime @default(now())

  @@unique([provider, entityType, externalId])
  @@unique([provider, entityType, entityId])
  @@index([entityType, entityId])
}

// Permissões de escrita configuráveis por área (Fase 0d, docs/plano-fase-0-fundacoes.md). Sem linha = predefinição
// em código (src/auth/permissions.ts). A administração nunca é configurável.
model PermissionSetting {
  area      String   @id
  roles     Role[]
  updatedAt DateTime @updatedAt
}

/// Garantia do equipamento de uma assistência: muitas vezes não se sabe ao receber.
enum ServiceWarranty {
  YES
  NO
  UNKNOWN
}

/// Assistência (módulo assistencias, Fase 4a, docs/plano-fase-4-assistencias.md): dados próprios de um item de trabalho
/// do tipo «Assistência», 1:1 (apagar a tarefa apaga-os). O passo, o estado, o responsável e o prazo são os da tarefa.
model ServiceCase {
  workItemId      String          @id
  workItem        WorkItem        @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  /// Número legível (AS-0001), sequencial e sem repetições (sequência da base de dados).
  number          Int             @unique @default(autoincrement())
  brand           String?
  model           String?
  serialNumber    String?
  underWarranty   ServiceWarranty @default(UNKNOWN)
  reportedProblem String
  diagnosis       String?
  resolution      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  parts           ServicePart[]

  @@index([serialNumber])
}

/// Peça usada numa assistência (Fase 4c). Texto até existirem produtos (Fase 5); quantidade > 0 (CHECK na migração).
model ServicePart {
  id            String      @id @default(uuid())
  serviceCaseId String
  serviceCase   ServiceCase @relation(fields: [serviceCaseId], references: [workItemId], onDelete: Cascade)
  description   String
  reference     String?
  quantity      Decimal     @default(1) @db.Decimal(10, 2)
  /// Produto do catálogo de onde a peça veio (Fase 5c). Não se apaga enquanto houver peças com ele.
  productId     String?
  product       Product?    @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Quanto esta peça tirou do stock, líquido (Fase 5c; ≥ 0 por CHECK). É o que volta ao retirá-la.
  stockTaken    Decimal     @default(0) @db.Decimal(12, 2)
  createdById   String?
  createdBy     User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([serviceCaseId, createdAt])
  @@index([productId])
}

/// Registo de tempo num item de trabalho (Fase 4b, docs/plano-fase-4-assistencias.md). Sem fim = a correr.
/// Um só a correr por pessoa: `runningUserId` (única) só está preenchida enquanto corre; uma CHECK na migração liga-a ao
/// fim vazio e ao utilizador do registo, e outra impede o fim antes do início.
model TimeEntry {
  id            String    @id @default(uuid())
  workItemId    String
  workItem      WorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation("TimeEntryUser", fields: [userId], references: [id])
  startedAt     DateTime
  endedAt       DateTime?
  runningUserId String?   @unique
  note          String?
  billable      Boolean   @default(true)
  manual        Boolean   @default(false)
  /// Última mudança de horas: motivo, quando e por quem.
  editReason    String?
  editedAt      DateTime?
  editedById    String?
  editedBy      User?     @relation("TimeEntryEditor", fields: [editedById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workItemId, startedAt])
  @@index([userId, startedAt])
}

/// Unidades de venda dos produtos (Fase 5a).
enum ProductUnit {
  UN
  CX
  PACK
  KG
  M
  L
  H
}

/// Produto do catálogo (Fase 5a, docs/plano-fase-5-produtos-stock.md). Referência em maiúsculas e única; preço sem
/// IVA (vazio = sob consulta). `searchText` é mantido por trigger (pesquisa sem acentos), como nas empresas.
model Product {
  id             String            @id @default(uuid())
  sku            String            @unique
  barcode        String?           @unique
  name           String
  description    String?
  unit           ProductUnit       @default(UN)
  salePrice      Decimal?          @db.Decimal(12, 2)
  vatRate        Decimal           @default(23) @db.Decimal(5, 2)
  categoryId     String?
  category       ProductCategory?  @relation(fields: [categoryId], references: [id])
  active         Boolean           @default(true)
  /// Controla stock (D6): não para serviços e revenda direta.
  tracksStock    Boolean           @default(true)
  /// Stock mínimo para o alerta (Fase 5b).
  minStock       Decimal?          @db.Decimal(12, 2)
  /// Stock atual = soma dos movimentos (Fase 5b), mantido por trigger a cada movimento novo.
  stockOnHand    Decimal           @default(0) @db.Decimal(12, 2)
  /// Abaixo do mínimo (mínimo definido e stock atual menor), mantido por trigger.
  belowMin       Boolean           @default(false)
  /// Reservado para encomendas confirmadas (Fase 6b) = soma de SalesOrderLine.reservedQuantity, mantido por trigger.
  /// Disponível = stockOnHand − reserved (calculado na resposta).
  reserved       Decimal           @default(0) @db.Decimal(12, 2)
  searchText     String            @default("")
  suppliers      ProductSupplier[]
  stockMovements StockMovement[]
  serviceParts   ServicePart[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  salesOrderLines    SalesOrderLine[]
  purchaseOrderLines PurchaseOrderLine[]

  @@index([categoryId])
  @@index([belowMin])
  @@index([stockOnHand])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// Categoria de produtos (lista simples). `nameKey` = nome sem maiúsculas nem espaços nas pontas, para ser único.
model ProductCategory {
  id        String    @id @default(uuid())
  name      String
  nameKey   String    @unique
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Fornecedor de um produto: a referência e o custo do fornecedor. No máximo um preferido por produto, garantido pela
/// base de dados: `preferredFor` (única) só está preenchida no preferido, com o id do produto (CHECK na migração).
model ProductSupplier {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplierSku  String?
  costPrice    Decimal? @db.Decimal(12, 4)
  preferredFor String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([productId, companyId])
  @@index([companyId])
}

/// Tipos de movimento de stock (Fase 5b). O sinal de cada um é garantido por CHECK na migração.
enum StockMovementType {
  INITIAL
  PURCHASE_IN
  SALE_OUT
  RETURN
  ADJUSTMENT
  SERVICE_PART
}

/// Movimento de stock (Fase 5b, docs/plano-fase-5-produtos-stock.md): só se acrescenta (trigger recusa alterar e
/// apagar). A quantidade tem sinal; o stock atual do produto é a soma (Product.stockOnHand, por trigger).
model StockMovement {
  id         String            @id @default(uuid())
  productId  String
  product    Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity   Decimal           @db.Decimal(12, 2)
  type       StockMovementType
  reason     String?
  note       String?
  /// Origem (ex.: SERVICE_CASE e o id da assistência, na 5c).
  sourceType String?
  sourceId   String?
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt  DateTime          @default(now())

  @@index([productId, createdAt])
  @@index([sourceType, sourceId])
}

/// Estado de uma encomenda de cliente (Fase 6a, docs/plano-fase-6-encomendas.md). Fixo em código: mexe em stock (6b).
enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

/// Encomenda de cliente (Fase 6a). Valores indicativos, sem IVA por linha; a fatura sai do programa de faturação.
/// Cliente = empresa e/ou contacto (CHECK na migração). `searchText` por trigger (número, referência, cliente).
model SalesOrder {
  id                String           @id @default(uuid())
  number            Int              @unique @default(autoincrement())
  status            SalesOrderStatus @default(DRAFT)
  companyId         String?
  company           Company?         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contactId         String?
  contact           Contact?         @relation(fields: [contactId], references: [id], onDelete: Restrict)
  assigneeId        String?
  assignee          User?            @relation("SalesOrderAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  customerReference String?
  deliveryAddress   String?
  notes             String?
  subtotal          Decimal          @default(0) @db.Decimal(14, 2)
  vatTotal          Decimal          @default(0) @db.Decimal(14, 2)
  total             Decimal          @default(0) @db.Decimal(14, 2)
  confirmedAt       DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  /// Quando se criou a tarefa «Preparar encomenda» (Fase 6c): uma vez por encomenda, reclamada antes de criar.
  preparationTaskAt DateTime?
  createdById       String?
  createdBy         User?            @relation("SalesOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  searchText        String           @default("")
  lines             SalesOrderLine[]
  /// Tarefas ligadas (Fase 6c: «Preparar encomenda»).
  workItems         WorkItem[]
  /// Expedições (Fase 6d): cada envio, total ou parcial.
  shipments         Shipment[]

  @@index([status, createdAt])
  @@index([createdAt, id])
  @@index([companyId])
  @@index([contactId])
  @@index([assigneeId])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// Linha de uma encomenda de cliente (Fase 6a): produto do catálogo (opcional) ou texto livre. Limites por CHECK.
model SalesOrderLine {
  id                String         @id @default(uuid())
  orderId           String
  order             SalesOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  position          Int
  productId         String?
  product           Product?       @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku               String?
  description       String
  quantity          Decimal        @db.Decimal(12, 2)
  unitPrice         Decimal        @db.Decimal(12, 2)
  discountPct       Decimal        @default(0) @db.Decimal(5, 2)
  vatRate           Decimal        @db.Decimal(5, 2)
  /// Total da linha sem IVA, já com o desconto (arredondado a cêntimos).
  lineTotal         Decimal        @db.Decimal(14, 2)
  /// Stock reservado para esta linha (Fase 6b): 0 até ao que falta enviar; o resto «aguarda stock». CHECK na migração.
  reservedQuantity  Decimal        @default(0) @db.Decimal(12, 2)
  /// Quanto já saiu em expedições (Fase 6d): 0 até à quantidade. CHECK na migração.
  shippedQuantity   Decimal        @default(0) @db.Decimal(12, 2)
  /// Por enviar = quantidade − enviado (Fase 6d). Mantido por trigger (nunca se escreve), para os filtros o compararem
  /// com o reservado.
  unshippedQuantity Decimal        @default(0) @db.Decimal(12, 2)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  shipmentLines     ShipmentLine[]

  @@index([orderId, position])
  @@index([productId])
}

/// Transportadora (Fase 6d): lista curta de configuração. O link de seguimento tem `{codigo}` (CHECK na migração).
model Carrier {
  id                  String     @id @default(uuid())
  name                String
  nameKey             String     @unique
  trackingUrlTemplate String?
  active              Boolean    @default(true)
  sortOrder           Int        @default(0)
  shipments           Shipment[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

/// Expedição de uma encomenda (Fase 6d): um envio, total ou parcial. As quantidades não mudam depois de registada
/// (o stock já saiu); os dados do transporte corrigem-se. Limites por CHECK.
model Shipment {
  id           String         @id @default(uuid())
  orderId      String
  order        SalesOrder     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  carrierId    String?
  carrier      Carrier?       @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  trackingCode String?
  packages     Int?
  weightKg     Decimal?       @db.Decimal(10, 2)
  cost         Decimal?       @db.Decimal(12, 2)
  notes        String?
  shippedAt    DateTime       @default(now())
  createdById  String?
  createdBy    User?          @relation("ShipmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  lines        ShipmentLine[]

  @@index([orderId, shippedAt])
  @@index([carrierId])
}

/// Linha de uma expedição (Fase 6d): quanto saiu de uma linha da encomenda. Uma vez por linha em cada expedição.
model ShipmentLine {
  id          String         @id @default(uuid())
  shipmentId  String
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderLineId String
  orderLine   SalesOrderLine @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  quantity    Decimal        @db.Decimal(12, 2)

  @@unique([shipmentId, orderLineId])
  @@index([orderLineId])
}

/// Estado de uma compra a fornecedor (Fase 6c, docs/plano-fase-6-encomendas.md). «Recebida em parte» é uma enviada com
/// alguma receção (calculado).
enum PurchaseOrderStatus {
  DRAFT
  SENT
  RECEIVED
  CLOSED
  CANCELLED
}

/// Compra a fornecedor (Fase 6c). Valores indicativos (custo sem IVA). `searchText` por trigger (número, referência do
/// fornecedor); o nome do fornecedor pesquisa-se no texto da empresa.
model PurchaseOrder {
  id                String              @id @default(uuid())
  number            Int                 @unique @default(autoincrement())
  status            PurchaseOrderStatus @default(DRAFT)
  supplierId        String
  supplier          Company             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierReference String?
  expectedAt        DateTime?           @db.Date
  notes             String?
  total             Decimal             @default(0) @db.Decimal(14, 2)
  sentAt            DateTime?
  receivedAt        DateTime?
  closedAt          DateTime?
  cancelledAt       DateTime?
  /// Motivo de fechar com falta ou de cancelar.
  closeReason       String?
  createdById       String?
  createdBy         User?               @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  searchText        String              @default("")
  lines             PurchaseOrderLine[]

  @@index([status, createdAt])
  @@index([createdAt, id])
  @@index([supplierId])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// Linha de uma compra (Fase 6c): sempre um produto do catálogo, no máximo uma vez por compra. Limites por CHECK
/// (quantidade > 0, custo ≥ 0, 0 ≤ recebido ≤ quantidade).
model PurchaseOrderLine {
  id               String        @id @default(uuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  position         Int
  productId        String
  product          Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku              String
  description      String
  supplierSku      String?
  quantity         Decimal       @db.Decimal(12, 2)
  unitCost         Decimal       @db.Decimal(12, 4)
  /// Quantidade × custo, arredondado a cêntimos.
  lineTotal        Decimal       @db.Decimal(14, 2)
  receivedQuantity Decimal       @default(0) @db.Decimal(12, 2)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([purchaseOrderId, productId])
  @@index([purchaseOrderId, position])
  @@index([productId])
}
