{
  "id": "ola-mundo",
  "name": "Olá mundo",
  "description": "Extensão de exemplo: conta as leads criadas e lê as definições.",
  "version": "1.0.0",
  "sdk": "^1.0.0",
  "origin": "installed",
  "dependsOn": {
    "leads": "^1.0.0"
  },
  "provides": [],
